# AI Model Provider ("ollama" for local machine, "groq" for cloud hosting)
LLM_PROVIDER=ollama

# Cloud Groq Settings (Only needed if LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=qwen-2.5-32b

# Ollama Local Configuration (Used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=all-minilm
VISION_MODEL=moondream

# Security & Storage
JWT_SECRET=mukku_ai_super_secret_local_key_2026
MAX_UPLOAD_SIZE_MB=25
MAX_CONTEXT_TOKENS=3000
RECENT_MESSAGES_COUNT=6
